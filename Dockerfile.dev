FROM node:20-bookworm-slim

WORKDIR /app
ENV HUSKY=0

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY prisma ./prisma
RUN npm ci && npx prisma generate

EXPOSE 3000

CMD ["sh", "-c", "if [ ! -d node_modules/.bin ]; then npm ci; fi && npx prisma generate && npm run start:dev"]

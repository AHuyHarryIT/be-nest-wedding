FROM node:20-bookworm-slim

WORKDIR /app
ENV HUSKY=0

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY prisma ./prisma
RUN npm ci && npx prisma generate

EXPOSE 3000

# Always install dependencies on container start to pick up new packages
# Then generate Prisma client and start the dev server
CMD ["sh", "-c", "npm ci && npx prisma generate && npm run start:dev"]

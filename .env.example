# App
PORT=3000
NODE_ENV=development
API_VERSION=1.0.0
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
DEFAULT_CHAT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appdb
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb

# Security
HASH_SALT=10

# JWT
JWT_ACCESS_SECRET=your-access-jwt-secret
JWT_ACCESS_EXPIRES_IN=600
JWT_REFRESH_SECRET=your-refresh-jwt-secret
JWT_REFRESH_EXPIRES_IN=604800

# Azure / OneDrive
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_USER_ID=your-azure-user-id

# MoMo
MOMO_API=https://test-payment.momo.vn
MOMO_BASE_URL=http://localhost:3000
MOMO_ACCESS_KEY=your-momo-access-key
MOMO_SECRET_KEY=your-momo-secret-key
MOMO_IPN_URL=http://localhost:3000/orders/momo/callback
MOMO_REDIRECT_URL=http://127.0.0.1:5173/bookings/payment-result

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# AI Provider Configuration
CHAT_AI_PROVIDER=anthropic

# Anthropic AI Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI AI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Chat AI Controls
CHAT_AI_ENABLED=false
CHAT_AI_MAX_CONTEXT_MESSAGES=10
CHAT_AI_MAX_INPUT_CHARS=6000
CHAT_AI_MAX_CATALOG_ITEMS=10
CHAT_AI_MAX_OUTPUT_TOKENS=240
CHAT_AI_TIMEOUT_MS=8000

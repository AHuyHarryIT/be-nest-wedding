
# App
PORT=3000
NODE_ENV=development

# Database (Docker compose uses these)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appdb

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}"

# JWT Configuration
JWT_SECRET=super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# OneDrive/Azure Configuration
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_USER_ID=your-azure-user-id

# AI Provider Configuration
CHAT_AI_PROVIDER=anthropic

# Anthropic AI Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI AI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Chat AI Controls
CHAT_AI_ENABLED=false
CHAT_AI_MAX_CONTEXT_MESSAGES=10
CHAT_AI_MAX_INPUT_CHARS=6000
CHAT_AI_MAX_OUTPUT_TOKENS=240
CHAT_AI_TIMEOUT_MS=8000

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum BookingStatus {
  PENDING
  DEPOSIT_PAID
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  E_WALLET
}

enum PaymentStatus {
  PENDING
  PARTIAL_PAID
  SUCCESSFUL
  FAILED
  CANCELLED
  ABANDONED
  REFUNDED
}

enum PaymentType {
  DEPOSIT
  REMAINING
  INSTALLMENT
  FULL
  ADJUSTMENT
}

enum PaymentAttemptStatus {
  INITIATED
  IN_PROGRESS
  SUCCESS
  FAILED
  TIMEOUT
  CANCELLED
}

enum RefundReason {
  CUSTOMER_REQUEST
  OVERPAYMENT
  CANCELLATION
  ERROR
  DUPLICATE
  FRAUD_SUSPECTED
  OTHER
}

enum RefundStatus {
  INITIATED
  PROCESSING
  SUCCESSFUL
  FAILED
  REJECTED
  PENDING_REVERIFICATION
}

enum RefundAttemptStatus {
  INITIATED
  PROCESSING
  SUCCESS
  FAILED
  TIMEOUT
}

enum VisibilityLevel {
  PUBLIC
  PRIVATE
  UNLISTED
}

model Customer {
  id                 String         @id @default(uuid())
  phoneNumber        String         @unique @map("phone_number")
  passwordHash       String         @map("password_hash")
  firstName          String?        @map("first_name")
  lastName           String?        @map("last_name")
  email              String?
  avatarUrl          String?        @map("avatar_url")
  isActive           Boolean        @default(true) @map("is_active")
  refreshToken       String?        @map("refresh_token")
  refreshTokenExpiry DateTime?      @map("refresh_token_expiry")
  weddingDate        DateTime?      @map("wedding_date")
  weddingVenue       String?        @map("wedding_venue")
  emailNotifications Boolean        @default(true) @map("email_notifications")
  smsNotifications   Boolean        @default(true) @map("sms_notifications")
  marketingEmails    Boolean        @default(false) @map("marketing_emails")
  // relation
  bookings           Booking[]
  albums             Album[]
  chats              Chat[]         @relation("chat_customer")
  messages           Message[]      @relation("message_customer_sender")
  staffChats         StaffChat[]    @relation("staff_chat_customer")
  staffMessages      StaffMessage[] @relation("staff_message_customer_sender")
  aiThreads          AiThread[]     @relation("ai_thread_customer")
  aiMessages         AiMessage[]    @relation("ai_message_customer_sender")
  authSessions       AuthSession[]
  // timestamps
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  deletedAt          DateTime?      @map("deleted_at")

  @@map("customers")
}

model AuthSession {
  id         String    @id @default(uuid())
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  customerId String?   @map("customer_id")
  staffId    String?   @map("staff_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff    Staff?    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([staffId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model PublicInquiry {
  id              String   @id @default(uuid()) @map("id")
  name            String   @map("name")
  email           String   @map("email")
  message         String   @map("message")
  phone           String?  @map("phone")
  packageInterest String?  @map("package_interest")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([createdAt])
  @@map("public_inquiries")
}

model Staff {
  id                 String         @id
  phoneNumber        String         @unique @map("phone_number")
  passwordHash       String         @map("password_hash")
  firstName          String?        @map("first_name")
  lastName           String?        @map("last_name")
  email              String?
  avatarUrl          String?        @map("avatar_url")
  isActive           Boolean        @default(true) @map("is_active")
  refreshToken       String?        @map("refresh_token")
  refreshTokenExpiry DateTime?      @map("refresh_token_expiry")
  // relation
  roles              StaffRole[]
  staffJobs          StaffJob[]
  assignedBookings   BookingStaff[]
  sessions           SessionStaff[]
  files              File[]
  albums             Album[]
  chats              Chat[]         @relation("chat_staff")
  messages           Message[]      @relation("message_staff_sender")
  staffChats         StaffChat[]    @relation("staff_chat_staff")
  staffMessages      StaffMessage[] @relation("staff_message_staff_sender")
  authSessions       AuthSession[]
  // timestamps
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  deletedAt          DateTime?      @map("deleted_at")

  @@map("staffs")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  // relation
  staff       StaffRole[]
  permissions RolePermission[]
  // timestamps
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  // relation
  roles       RolePermission[]
  // timestamps
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("permissions")
}

model StaffRole {
  staffId String @map("staff_id")
  roleId  String @map("role_id")
  // relation
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([staffId, roleId])
  @@index([roleId])
  @@map("staff_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  // relation
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Service {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Float   @default(0)
  isActive    Boolean @default(false) @map("is_active")
  isLocation  Boolean @default(false) @map("is_location")
  isTime      Boolean @default(false) @map("is_time")
  jobId       String? @map("job_id")

  // Image fields
  imageUrl           String? @map("image_url")
  cloudinaryPublicId String? @map("cloudinary_public_id")

  // relation
  job      Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  packages PackageService[]
  sessions SessionService[]
  bookings BookingService[]

  // timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([jobId])
  @@map("services")
}

model Job {
  id           String     @id @default(uuid())
  name         String     @unique
  description  String?
  isActive     Boolean    @default(false) @map("is_active")
  services     Service[]
  staffMembers StaffJob[]
  deletedAt    DateTime?  @map("deleted_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("jobs")
}

model StaffJob {
  staffId String @map("staff_id")
  jobId   String @map("job_id")

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([staffId, jobId])
  @@index([jobId])
  @@map("staff_jobs")
}

model Package {
  id                 String  @id @default(uuid())
  name               String
  description        String?
  price              Float   @default(0)
  isActive           Boolean @default(false) @map("is_active")
  coverImageUrl      String? @map("cover_image_url")
  coverImagePublicId String? @map("cover_image_public_id")

  // relation
  services        PackageService[]
  images          PackageImage[]
  bookingPackages BookingPackage[]

  // timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("packages")
}

model PackageImage {
  id                 String   @id @default(uuid())
  packageId          String   @map("package_id")
  imageUrl           String   @map("image_url")
  cloudinaryPublicId String   @map("cloudinary_public_id")
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, sortOrder])
  @@map("package_images")
}

model PackageService {
  packageId String  @map("package_id")
  serviceId String  @map("service_id")
  // relation
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([packageId, serviceId])
  @@index([serviceId])
  @@map("package_services")
}

model Booking {
  id             String           @id @default(uuid())
  customerId     String           @map("customer_id")
  notes          String?
  status         BookingStatus    @default(PENDING)
  eventDate      DateTime         @map("event_date")
  totalPrice     Float            @default(0) @map("total_price")
  cancelledAt    DateTime?        @map("cancelled_at")
  // relation
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedStaffs BookingStaff[]
  packages       BookingPackage[]
  services       BookingService[]
  sessions       BookingSession[]
  albums         Album[]
  orders         Order[]
  chats          Chat[]
  staffChats     StaffChat[]      @relation("staff_chat_booking")
  aiThreads      AiThread[]       @relation("ai_thread_booking")

  // timestamps
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @default(now()) @map("updated_at")
  deletedAt      DateTime?              @map("deleted_at")

  @@index([customerId, status, createdAt])
  @@map("bookings")
}

model BookingStaff {
  bookingId    String   @map("booking_id")
  sourceKey    String   @map("source_key")
  staffId      String   @map("staff_id")
  job          String?  @map("job")
  serviceLabel String?  @map("service_label")
  locationName String?  @map("location_name")
  startTime    String?  @map("start_time")
  endTime      String?  @map("end_time")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([bookingId, sourceKey])
  @@index([staffId])
  @@map("booking_staffs")
}

model BookingPackage {
  bookingId String  @map("booking_id")
  packageId String  @map("package_id")
  price     Float   @default(0) // Price at time of booking
  quantity  Int     @default(1)
  // relation
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@id([bookingId, packageId])
  @@index([packageId])
  @@map("booking_packages")
}

model BookingService {
  bookingId String  @map("booking_id")
  serviceId String  @map("service_id")
  price     Float   @default(0) // Price at time of booking
  quantity  Int     @default(1)
  // relation
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([bookingId, serviceId])
  @@index([serviceId])
  @@map("booking_services")
}

model BookingSession {
  id           String        @id @default(uuid())
  bookingId    String        @map("booking_id")
  title        String
  locationName String?       @map("location_name")
  address      String?
  startsAt     DateTime      @map("starts_at")
  endsAt       DateTime      @map("ends_at")
  status       BookingStatus @default(PENDING)

  // relation
  booking  Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staffs   SessionStaff[]
  services SessionService[]

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@index([bookingId])
  @@index([startsAt, endsAt])
  @@index([status])
  @@map("booking_sessions")
}

model SessionStaff {
  sessionId String @map("session_id")
  staffId   String @map("staff_id")

  // relation
  session BookingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staff   Staff          @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([sessionId, staffId])
  @@map("session_staffs")
}

model SessionService {
  sessionId String @map("session_id")
  serviceId String @map("service_id")
  price     Float  @default(0)

  // relation
  session BookingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  service Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([sessionId, serviceId])
  @@map("session_services")
}

model Order {
  id                 String      @id @default(uuid())
  bookingId          String      @map("booking_id")
  referenceNumber    String      @unique @map("reference_number")
  totalPrice         Float       @default(0) @map("total_price")
  totalPaid          Float       @default(0) @map("total_paid")
  totalRefunded      Float       @default(0) @map("total_refunded")
  balanceRemaining   Float       @default(0) @map("balance_remaining")
  status             OrderStatus @default(UNPAID)
  notes              String?
  internalNotes      String?     @map("internal_notes")
  cancellationReason String?     @map("cancellation_reason")
  cancelledAt        DateTime?   @map("cancelled_at")

  // relation
  booking  Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payments Payment[]
  refunds  Refund[]

  // timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([bookingId])
  @@index([status])
  @@index([referenceNumber])
  @@index([createdAt])
  @@map("orders")
}

model Payment {
  id                  String        @id @default(uuid())
  orderId             String        @map("order_id")
  paymentSequence     Int           @default(1) @map("payment_sequence")
  paymentType         PaymentType   @default(REMAINING) @map("payment_type")
  amount              Float         @default(0)
  method              PaymentMethod
  status              PaymentStatus @default(PENDING)
  description         String?
  dueDate             DateTime?     @map("due_date")
  attemptCount        Int           @default(0) @map("attempt_count")
  lastAttemptAt       DateTime?     @map("last_attempt_at")
  successfulAttemptId String?       @map("successful_attempt_id")
  notes               String?
  internalNotes       String?       @map("internal_notes")
  cancelledAt         DateTime?     @map("cancelled_at")
  cancellationReason  String?       @map("cancellation_reason")

  // relation
  order    Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attempts PaymentAttempt[]

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([orderId, paymentSequence])
  @@index([orderId])
  @@index([status])
  @@index([dueDate])
  @@index([method])
  @@map("payments")
}

model PaymentAttempt {
  id              String               @id @default(uuid())
  paymentId       String               @map("payment_id")
  attemptNumber   Int                  @map("attempt_number")
  status          PaymentAttemptStatus @default(INITIATED)
  resultCode      String?              @map("result_code")
  resultMessage   String?              @map("result_message")
  errorReason     String?              @map("error_reason")
  attemptedAmount Float                @default(0) @map("attempted_amount")
  idempotencyKey  String               @unique @map("idempotency_key")
  userAgent            String?              @map("user_agent")
  ipAddress            String?              @map("ip_address")
  deviceInfo           String?              @map("device_info")
  createdBy            String?              @map("created_by")
  notes                String?
  requestedAt          DateTime             @default(now()) @map("requested_at")
  respondedAt          DateTime?            @map("responded_at")
  duration             Int?

  // relation
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([paymentId, attemptNumber])
  @@index([paymentId])
  @@index([status])
  @@index([requestedAt])
  @@map("payment_attempts")
}

model Refund {
  id                String       @id @default(uuid())
  orderId           String       @map("order_id")
  refundSequence    Int          @default(1) @map("refund_sequence")
  referenceNumber   String       @unique @map("reference_number")
  originalPaymentId String?      @map("original_payment_id")
  amount            Float        @default(0)
  reason            RefundReason @default(CUSTOMER_REQUEST)
  description       String?
  status            RefundStatus @default(INITIATED)
  processedAt       DateTime?    @map("processed_at")
  completedAt       DateTime?    @map("completed_at")
  authorizedBy      String?      @map("authorized_by")
  notes             String?
  internalNotes     String?      @map("internal_notes")

  // relation
  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attempts RefundAttempt[]

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([orderId, refundSequence])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("refunds")
}

model RefundAttempt {
  id              String              @id @default(uuid())
  refundId        String              @map("refund_id")
  attemptNumber   Int                 @map("attempt_number")
  amount          Float               @default(0)
  status          RefundAttemptStatus @default(INITIATED)
  resultCode      String?             @map("result_code")
  resultMessage   String?             @map("result_message")
  gatewayRefundId String?             @map("gateway_refund_id")
  notes           String?
  processedBy     String?             @map("processed_by")
  requestedAt     DateTime            @default(now()) @map("requested_at")
  respondedAt     DateTime?           @map("responded_at")

  // relation
  refund Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([refundId, attemptNumber])
  @@index([refundId])
  @@index([status])
  @@map("refund_attempts")
}

// Media and Albums
model File {
  id         String          @id @default(uuid())
  uploaderId String          @map("uploader_id")
  name       String
  storageKey String          @map("storage_key")
  storageUrl String          @map("storage_url")
  mimeType   String          @map("mime_type")
  byteSize   Int             @map("byte_size")
  width      Int?
  height     Int?
  usageType  String          @map("usage_type")
  visibility VisibilityLevel @default(PRIVATE)

  // relation
  uploader    Staff       @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  albums      AlbumFile[]
  coverAlbums Album[]

  // timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("files")
}

model Album {
  id               String    @id @default(uuid())
  ownerStaffId     String?   @map("owner_staff_id")
  bookingId        String?   @map("booking_id")
  customerId       String?   @map("customer_id")
  title            String
  description      String?
  isPublic         Boolean   @default(false) @map("is_public")
  share_token      String?   @unique @map("share_token")
  expiresAt        DateTime? @map("expires_at")
  coverFileId      String?   @map("cover_file_id")
  oneDriveFolderId String?   @map("onedrive_folder_id")

  // relation
  owner     Staff?      @relation(fields: [ownerStaffId], references: [id], onDelete: Cascade)
  booking   Booking?    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer  Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  coverFile File?       @relation(fields: [coverFileId], references: [id], onDelete: Cascade)
  files     AlbumFile[]

  // timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("albums")
}

model AlbumFile {
  albumId   String  @map("album_id")
  fileId    String  @map("file_id")
  sortOrder Int     @default(0) @map("sort_order")
  caption   String?

  // relation
  file  File  @relation(fields: [fileId], references: [id])
  album Album @relation(fields: [albumId], references: [id])

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")

  @@id([albumId, fileId])
  @@index([fileId])
  @@map("album_files")
}

// Chat and Messaging
enum ChatType {
  DIRECT
  GROUP
}

enum MessageSenderType {
  CUSTOMER
  STAFF
  AI
}

enum StaffMessageSenderType {
  CUSTOMER
  STAFF
}

enum AiMessageSenderType {
  CUSTOMER
  AI
}

model StaffChat {
  id                 String    @id @default(uuid())
  customerId         String    @map("customer_id")
  staffId            String?   @map("staff_id")
  bookingId          String?   @map("booking_id")
  canonicalThreadKey String    @unique @map("canonical_thread_key")
  lastMessageAt      DateTime? @map("last_message_at")
  isArchived         Boolean   @default(false) @map("is_archived")

  customer Customer       @relation("staff_chat_customer", fields: [customerId], references: [id], onDelete: Cascade)
  staff    Staff?         @relation("staff_chat_staff", fields: [staffId], references: [id], onDelete: SetNull)
  booking  Booking?       @relation("staff_chat_booking", fields: [bookingId], references: [id], onDelete: SetNull)
  messages StaffMessage[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([customerId, staffId])
  @@index([bookingId])
  @@index([lastMessageAt])
  @@index([canonicalThreadKey])
  @@map("staff_chats")
}

model StaffMessage {
  id               String                 @id @default(uuid())
  staffChatId      String                 @map("staff_chat_id")
  senderType       StaffMessageSenderType @default(CUSTOMER) @map("sender_type")
  senderCustomerId String?                @map("sender_customer_id")
  senderStaffId    String?                @map("sender_staff_id")
  content          String
  isRead           Boolean                @default(false) @map("is_read")
  readAt           DateTime?              @map("read_at")

  chat           StaffChat @relation(fields: [staffChatId], references: [id], onDelete: Cascade)
  senderCustomer Customer? @relation("staff_message_customer_sender", fields: [senderCustomerId], references: [id], onDelete: Cascade)
  senderStaff    Staff?    @relation("staff_message_staff_sender", fields: [senderStaffId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([staffChatId, createdAt])
  @@index([senderCustomerId])
  @@index([senderStaffId])
  @@index([isRead])
  @@map("staff_messages")
}

model AiThread {
  id                 String    @id @default(uuid())
  customerId         String    @map("customer_id")
  bookingId          String?   @map("booking_id")
  canonicalThreadKey String    @unique @map("canonical_thread_key")
  lastMessageAt      DateTime? @map("last_message_at")

  customer Customer    @relation("ai_thread_customer", fields: [customerId], references: [id], onDelete: Cascade)
  booking  Booking?    @relation("ai_thread_booking", fields: [bookingId], references: [id], onDelete: SetNull)
  messages AiMessage[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([customerId])
  @@index([bookingId])
  @@index([lastMessageAt])
  @@index([canonicalThreadKey])
  @@map("ai_threads")
}

model AiMessage {
  id               String              @id @default(uuid())
  aiThreadId       String              @map("ai_thread_id")
  senderType       AiMessageSenderType @default(CUSTOMER) @map("sender_type")
  senderCustomerId String?             @map("sender_customer_id")
  content          String
  isRead           Boolean             @default(false) @map("is_read")
  readAt           DateTime?           @map("read_at")

  thread         AiThread  @relation(fields: [aiThreadId], references: [id], onDelete: Cascade)
  senderCustomer Customer? @relation("ai_message_customer_sender", fields: [senderCustomerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([aiThreadId, createdAt])
  @@index([senderCustomerId])
  @@index([isRead])
  @@map("ai_messages")
}

model Chat {
  id                 String    @id @default(uuid())
  customerId         String    @map("customer_id")
  staffId            String?   @map("staff_id")
  bookingId          String?   @map("booking_id")
  canonicalThreadKey String    @unique @map("canonical_thread_key")
  chatType           ChatType  @default(DIRECT)
  lastMessageAt      DateTime? @map("last_message_at")
  isArchived         Boolean   @default(false) @map("is_archived")
  aiEnabled          Boolean   @default(true) @map("ai_enabled")

  // relation
  customer Customer  @relation("chat_customer", fields: [customerId], references: [id], onDelete: Cascade)
  staff    Staff?    @relation("chat_staff", fields: [staffId], references: [id], onDelete: SetNull)
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  messages Message[]

  // timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([customerId, staffId])
  @@index([bookingId])
  @@index([lastMessageAt])
  @@index([canonicalThreadKey])
  @@map("chats")
}

model Message {
  id               String            @id @default(uuid())
  chatId           String            @map("chat_id")
  senderType       MessageSenderType @default(CUSTOMER) @map("sender_type")
  senderCustomerId String?           @map("sender_customer_id")
  senderStaffId    String?           @map("sender_staff_id")
  content          String
  isRead           Boolean           @default(false) @map("is_read")
  readAt           DateTime?         @map("read_at")

  // relation
  chat           Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderCustomer Customer? @relation("message_customer_sender", fields: [senderCustomerId], references: [id], onDelete: Cascade)
  senderStaff    Staff?    @relation("message_staff_sender", fields: [senderStaffId], references: [id], onDelete: Cascade)

  // timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([chatId, createdAt])
  @@index([senderCustomerId])
  @@index([senderStaffId])
  @@index([isRead])
  @@map("messages")
}


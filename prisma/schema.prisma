// ╔══════════════════════════════════════════════════════════╗
// ║          INVENTORY MODULE (Sell & Rentals)              ║
// ╚══════════════════════════════════════════════════════════╝

enum ItemType {
  SOLD
  RENTAL
  SERVICE_ADDON
}

enum RentalStatus {
  AVAILABLE
  CHECKED_OUT
  MAINTENANCE
  DAMAGED
}

enum InventoryLogType {
  STOCK_IN
  STOCK_OUT
  CHECKOUT
  CHECKIN
  DAMAGE_REPORT
  MAINTENANCE_START
  MAINTENANCE_END
  ADJUSTMENT
}

model InventoryCategory {
  id        String   @id @default(uuid()) @map("id")
  name      String   @map("name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items InventoryItem[]

  @@map("inventory_categories")
}

model InventoryItem {
  id                String        @id @default(uuid()) @map("id")
  name              String        @map("name")
  description       String?       @map("description")
  type              ItemType      @map("type")
  sku               String?       @unique @map("sku")
  costPrice         Float         @default(0) @map("cost_price")
  sellPrice         Float         @default(0) @map("sell_price")
  rentalDeposit     Float?        @map("rental_deposit")
  rentalPricePerDay Float?        @map("rental_price_per_day")

  stockCount        Int           @default(0) @map("stock_count")
  checkedOutCount   Int           @default(0) @map("checked_out_count")
  lowStockThreshold Int?          @map("low_stock_threshold")

  rentalStatus      RentalStatus? @map("rental_status")

  categoryId        String?       @map("category_id")
  category          InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  imageUrl          String?       @map("image_url")
  isActive          Boolean       @default(true) @map("is_active")
  deletedAt         DateTime?     @map("deleted_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  logs              InventoryLog[]
  bookings          BookingInventoryItem[]
  quotations        QuotationInventoryItem[]
  reminders         Reminder[]

  @@index([categoryId])
  @@index([type])
  @@index([sku])
  @@index([isActive])
  @@map("inventory_items")
}

model InventoryLog {
  id          String           @id @default(uuid()) @map("id")
  itemId      String           @map("item_id")
  item        InventoryItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type        InventoryLogType @map("type")
  quantity    Int              @default(1) @map("quantity")
  note        String?          @map("note")

  checkoutDate       DateTime? @map("checkout_date")
  expectedReturnDate DateTime? @map("expected_return_date")
  actualReturnDate   DateTime? @map("actual_return_date")
  damageNote         String?   @map("damage_note")
  damageCost         Float?    @map("damage_cost")

  actorId   String? @map("actor_id")
  actor     Staff?  @relation("inventory_log_actor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([itemId])
  @@index([type])
  @@index([actorId])
  @@map("inventory_logs")
}

model BookingInventoryItem {
  id        String  @id @default(uuid()) @map("id")
  bookingId String  @map("booking_id")
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  itemId    String  @map("item_id")
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  quantity         Int     @default(1) @map("quantity")
  unitPrice        Float   @map("unit_price")
  discountPercent  Float   @default(0) @map("discount_percent")

  checkoutDate       DateTime? @map("checkout_date")
  expectedReturnDate DateTime? @map("expected_return_date")
  returnedAt         DateTime? @map("returned_at")
  damageCost         Float    @default(0) @map("damage_cost")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([bookingId, itemId])
  @@index([bookingId])
  @@index([itemId])
  @@map("booking_inventory_items")
}

// ╔══════════════════════════════════════════════════════════╗
// ║          QUOTATIONS MODULE                               ║
// ╚══════════════════════════════════════════════════════════╝

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

model Quotation {
  id              String           @id @default(uuid()) @map("id")
  quotationNumber String           @unique @map("quotation_number")
  customerId      String           @map("customer_id")
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  title           String           @map("title")
  notes           String?          @map("notes")
  status          QuotationStatus  @default(DRAFT) @map("status")

  validUntil      DateTime?        @map("valid_until")

  subtotal        Float            @default(0) @map("subtotal")
  discountPercent Float            @default(0) @map("discount_percent")
  taxPercent      Float            @default(0) @map("tax_percent")
  totalPrice      Float            @default(0) @map("total_price")

  createdById     String?          @map("created_by_id")
  createdBy       Staff?           @relation("quotation_creator", fields: [createdById], references: [id], onDelete: SetNull)

  convertedBookingId String?       @unique @map("converted_booking_id")
  convertedAt        DateTime?     @map("converted_at")

  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  inventoryItems QuotationInventoryItem[]
  services       QuotationService[]

  @@index([customerId])
  @@index([status])
  @@index([createdById])
  @@map("quotations")
}

model QuotationInventoryItem {
  id           String      @id @default(uuid()) @map("id")
  quotationId  String      @map("quotation_id")
  quotation    Quotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemId       String      @map("item_id")
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  quantity        Int    @default(1) @map("quantity")
  unitPrice       Float  @map("unit_price")
  discountPercent Float  @default(0) @map("discount_percent")

  createdAt DateTime @default(now()) @map("created_at")
  @@unique([quotationId, itemId])
  @@map("quotation_inventory_items")
}

model QuotationService {
  id           String    @id @default(uuid()) @map("id")
  quotationId  String    @map("quotation_id")
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  serviceId    String    @map("service_id")
  service      Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  quantity        Int    @default(1) @map("quantity")
  unitPrice       Float  @map("unit_price")
  discountPercent Float  @default(0) @map("discount_percent")

  createdAt DateTime @default(now()) @map("created_at")
  @@unique([quotationId, serviceId])
  @@map("quotation_services")
}

// ╔══════════════════════════════════════════════════════════╗
// ║          REMINDERS & NOTIFICATIONS MODULE                ║
// ╚══════════════════════════════════════════════════════════╝

enum ReminderType {
  BOOKING_REMINDER
  PAYMENT_REMINDER
  RENTAL_RETURN
  LOW_STOCK
  CUSTOM
}

enum ReminderStatus {
  PENDING
  TRIGGERED
  COMPLETED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

model Reminder {
  id          String          @id @default(uuid()) @map("id")
  type        ReminderType    @map("type")
  title       String          @map("title")
  message     String          @map("message")
  status      ReminderStatus  @default(PENDING) @map("status")

  scheduledAt DateTime        @map("scheduled_at")
  triggeredAt DateTime?       @map("triggered_at")

  bookingId   String?         @map("booking_id")
  customerId  String?         @map("customer_id")
  itemId      String?         @map("item_id")

  booking         Booking?       @relation("reminder_booking", fields: [bookingId], references: [id], onDelete: Cascade)
  customer        Customer?      @relation("reminder_customer", fields: [customerId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  notifications Notification[]

  @@index([status])
  @@index([scheduledAt])
  @@index([bookingId])
  @@index([customerId])
  @@index([type])
  @@map("reminders")
}

model Notification {
  id        String             @id @default(uuid()) @map("id")
  reminderId String            @map("reminder_id")
  reminder   Reminder          @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  channel   NotificationChannel @map("channel")
  title     String              @map("title")
  message   String              @map("message")
  isRead    Boolean             @default(false) @map("is_read")
  readAt    DateTime?           @map("read_at")

  recipientStaffId    String?   @map("recipient_staff_id")
  recipientCustomerId String?   @map("recipient_customer_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([reminderId])
  @@index([isRead])
  @@index([recipientStaffId])
  @@index([createdAt])
  @@map("notifications")
}

